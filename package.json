{
  "name": "chatapp-desktop",
  "version": "1.0.4",
  "description": "App de chat + compartilhamento de tela (estilo Discord) para Windows",
  "main": "main.js",
  "dependencies": {
    "socket.io-client": "^4.7.5",
    "electron-updater": "^6.3.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.seuapp.chat",
    "productName": "ChatApp",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "imleozzin",
      "repo": "chatapp-desktop",
      "releaseType": "release"
    }
  }
}
